{
  "name": "cogito-mem",
  "displayName": "cogito-mem (Cogi)",
  "version": "0.2.1",
  "description": "Local long-term memory for Claude Code. Cogi saves every message you and Claude exchange, word for word, and brings back what matters with each prompt. No API key, no cloud: nothing leaves your machine.",
  "author": {
    "name": "meridian21lab",
    "url": "https://github.com/meridian21lab"
  },
  "homepage": "https://meridian21lab.github.io/cogito-mem/",
  "repository": "https://github.com/meridian21lab/cogito-mem",
  "documentationUrl": "https://meridian21lab.github.io/cogito-mem/",
  "supportUrl": "https://github.com/meridian21lab/cogito-mem/issues",
  "privacyPolicyUrl": "https://meridian21lab.github.io/cogito-mem/privacy.html",
  "termsOfServiceUrl": "https://meridian21lab.github.io/cogito-mem/terms.html",
  "license": "MIT",
  "icon": "./icon.png",
  "keywords": [
    "memory",
    "long-term-memory",
    "local-first",
    "privacy",
    "recall",
    "context",
    "session",
    "mcp",
    "embeddings",
    "llama.cpp"
  ],
  "userConfig": {
    "memory_name": {
      "type": "string",
      "title": "Name your memory",
      "description": "Where Cogi keeps your nuts. Leave empty for <your username>-hollow. Letters, digits, . _ - (up to 64).",
      "required": false
    }
  },
  "mcpServers": {
    "cogi": {
      "command": "uvx",
      "args": [
        "cogito-mem==0.2.1",
        "mcp"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_MEMORY_NAME": "${user_config.memory_name}"
      }
    }
  }
}
