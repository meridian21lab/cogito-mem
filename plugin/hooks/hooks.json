{
  "description": "cogito-mem: capture each turn into the local memory (in the background), and add relevant memory to each prompt and new session (set COGITO_MEM_RECALL=off to stop that)",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "uvx cogito-mem==0.2.1 capture claude-code", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "uvx cogito-mem==0.2.1 capture claude-code", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "uvx cogito-mem==0.2.1 recall claude-code", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "uvx cogito-mem==0.2.1 recall claude-code", "timeout": 15 }
        ]
      }
    ]
  }
}
