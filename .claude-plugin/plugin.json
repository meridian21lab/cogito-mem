  "license": "MIT",
  "keywords": ["memory", "mcp", "local-first", "embeddings", "llama.cpp", "recall"],
  "mcpServers": {
    "cogi": {
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cogito-mem-plugin", "mcp"]
    }
  }
}
