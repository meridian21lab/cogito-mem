{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.meridian21lab/cogito-mem",
  "title": "cogito-mem (Cogi)",
  "description": "Local long-term memory for agents: every message kept word for word, found by words and meaning.",
  "version": "0.2.0",
  "websiteUrl": "https://meridian21lab.github.io/cogito-mem/",
  "repository": {
    "url": "https://github.com/meridian21lab/cogito-mem",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "cogito-mem",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "COGITO_MEM_NAMESPACE",
          "description": "The memory's name (default: <your username>-hollow).",
          "isRequired": false
        }
      ]
    }
  ]
}
